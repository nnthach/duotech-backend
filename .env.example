# Sao chép thành .env rồi điền giá trị thật.
# Mọi biến mới PHẢI khai báo trong src/config/env.ts (Zod).

NODE_ENV=development
PORT=3000

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

DATABASE_HOST=localhost
DATABASE_PORT=5432

# Secret ký JWT — bắt buộc, không để trống. Đổi khác nhau giữa các môi trường.
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
