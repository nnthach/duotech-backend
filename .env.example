# Sao chép thành .env rồi điền giá trị thật.
# Mọi biến mới PHẢI khai báo trong src/config/env.ts (Zod).

NODE_ENV=development
PORT=3000

# Postgres (docker-compose đọc các biến này; có default nên để trống vẫn chạy)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# App connect qua chuỗi này: postgresql://user:password@host:port/db
DATABASE_URL=
